{
  "Serilog": {
    "Name": "ServiceFile",
    "MinimumLevel": {
      "Default": "Information",
      "Overwrite": {
        "Name": "Microsoft",
        "Level": "Error"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "E:/logs/statistic/statistic-.log",
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 10,
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true,
          "restrictedToMinimumLevel": "Warning"
        }
      },
      {
        "Name": "Console"
      }
    ]
  },
  "ConfigService": [ "http://10.4.194.27:7242/", "http://10.4.194.29:7242/" ],
  "TpBetRecordRelayParam": {
    "StartTime": "08:10", //Not Null.Work start doing at this time
    "EndTime": "08:20", //Not Null.Work must finish at this time
    "TimeOutSeconds": 600, //Not Null.Default=30,wait for SP seconds.
    "CheckTime": 10, //Not Null.Every 10 secs check whether this work has already run
    "ColdDownTime": 10 //Not Null.Every thread sleep 10 sec when finish
  },
  "CustClosingBalanceUTCSevenParam": {
    "TimeZone": 7, //Not Null.Get Data When UTC+7
    "StartTime": "07:00", //Not Null.Work start doing at this time
    "EndTime": "08:00", //Not Null.Work must finish at this time
    "CheckTime": 10, //Not Null.Every 10 secs check whether this work has already run
    "ColdDownTime": 10 //Not Null.Every thread sleep 10 sec when finish
  },
  "CustClosingBalanceUTCEightParam": {
    "TimeZone": 8, //Not Null.Get Data When UTC+8
    "StartTime": "08:00", //Not Null.Work start doing at this time
    "EndTime": "09:00", //Not Null.Work must finish at this time
    "CheckTime": 10, //Not Null.Every 10 secs check whether this work has already run
    "ColdDownTime": 10 //Not Null.Every thread sleep 10 sec when finish
  }
  
}
